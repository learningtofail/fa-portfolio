{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vitest/globals", "node"],
    // Ratchet: start permissive so the existing JS passes, then tighten one flag per phase.
    // src/lib and src/components/kit carry JSDoc types. noImplicitAny stays off until the D3 charts and the test
    // files are typed too (about 100 findings today, mostly d3 selections and test helpers).
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*", "*.js", "*.mjs"],
  "exclude": ["dist", "node_modules"]
}
