---
import Base from "../../layouts/Base.astro";
import { tools } from "../../data/tools.js";
---

<Base title="Tools — Faysal Ahmed">
  <main id="main-content" tabindex="-1" class="page page--index">
    <h1>Tools</h1>
    <p>Client-side only — nothing you upload leaves your browser.</p>
    <ul class="tool-list">
      {tools.map((tool) => (
        <li class="tool-list__item">
          {tool.live ? (
            <a href={`/tools/${tool.slug}/`}>
              <strong>{tool.name}</strong>
            </a>
          ) : (
            <span>
              <strong>{tool.name}</strong> <em>(coming soon)</em>
            </span>
          )}
          <p class="tool-list__text">{tool.description}</p>
        </li>
      ))}
    </ul>
  </main>
</Base>
