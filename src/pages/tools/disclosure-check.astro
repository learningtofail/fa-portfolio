---
import Base from "../../layouts/Base.astro";
import DisclosureChecker from "../../components/DisclosureChecker.jsx";
---

<Base
  title="Disclosure Language Checker — Faysal Ahmed"
  description="Check marketing copy for missing common disclosure language, entirely in your browser. Not legal advice."
>
  <main id="main-content" tabindex="-1" class="page">
    <p>
      <a href="/tools/">&larr; All tools</a>
    </p>
    <h1>Disclosure Language Checker</h1>
    <p class="page__intro">
      Scans copy for common required disclosure phrasing across a few regulated categories — affiliate/sponsored
      content, health/pharma, age-restricted products, and financial services. A pattern-matching aid, not a compliance
      sign-off. Nothing you enter is sent anywhere.
    </p>
    <DisclosureChecker client:visible />
  </main>
</Base>
