---
import Base from "../../layouts/Base.astro";
import CacCalculator from "../../components/CacCalculator.jsx";
---
<Base
  title="CAC / LTV / Payback Calculator — Faysal Ahmed"
  description="Model customer acquisition cost, lifetime value, and payback period, entirely in your browser."
>
  <main id="main-content" tabindex="-1" style="font-family: system-ui, sans-serif; max-width: 960px; margin: 3rem auto; padding: 0 1.5rem;">
    <p><a href="/tools/">&larr; All tools</a></p>
    <h1>CAC / LTV / Payback Calculator</h1>
    <p style="color: #555; max-width: 640px;">
      Enter spend, new customers, revenue, margin, and churn — get CAC, LTV, LTV:CAC ratio, and
      payback period, updated live as you type. All calculations run in this browser tab.
    </p>
    <CacCalculator client:visible />
  </main>
</Base>
