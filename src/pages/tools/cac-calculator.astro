---
import Base from "../../layouts/Base.astro";
import CacCalculator from "../../components/CacCalculator.jsx";
---

<Base
  title="CAC / LTV / Payback Calculator — Faysal Ahmed"
  description="Model customer acquisition cost, lifetime value, and payback period, entirely in your browser."
>
  <main id="main-content" tabindex="-1" class="page">
    <p>
      <a href="/tools/">&larr; All tools</a>
    </p>
    <h1>CAC / LTV / Payback Calculator</h1>
    <p class="page__intro">
      Enter spend, new customers, revenue, margin, and churn — get CAC, LTV, LTV:CAC ratio, and payback period, updated
      live as you type. All calculations run in this browser tab.
    </p>
    <CacCalculator client:visible />
  </main>
</Base>
