---
import ToolLayout from "../../layouts/ToolLayout.astro";
import { tools } from "../../data/tools.js";
import AttributionTool from "../../components/tools/AttributionTool.jsx";
import DisclosureChecker from "../../components/tools/DisclosureChecker.jsx";

// One page per live tool: /tools/<slug>/. Adding a tool is a catalog entry in data/tools.js, a lib module, a thin
// component in components/tools/, and one line below. Astro cannot hydrate a component picked at runtime
// (`const Tool = map[slug]`), so each island is named here where Astro can see its import.
export function getStaticPaths() {
  return tools.filter((t) => t.live).map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props;
---

<ToolLayout tool={tool}>
  {tool.slug === "attribution" && <AttributionTool client:visible />}
  {tool.slug === "disclosure-check" && <DisclosureChecker client:visible />}
</ToolLayout>
