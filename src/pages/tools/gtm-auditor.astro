---
import Base from "../../layouts/Base.astro";
import GtmAuditor from "../../components/GtmAuditor.jsx";
---

<Base
  title="GTM Container Auditor — Faysal Ahmed"
  description="Upload a GTM container export and audit tag/trigger/variable hygiene, entirely in your browser."
>
  <main id="main-content" tabindex="-1" class="page">
    <p>
      <a href="/tools/">&larr; All tools</a>
    </p>
    <h1>GTM Container Auditor</h1>
    <p class="page__intro">
      Checks a GTM container export for the hygiene problems that accumulate in long-running containers: paused tags,
      tags with no firing trigger, unused variables and triggers, duplicate names, and generic default names nobody got
      around to renaming. Nothing you upload is sent anywhere — parsing and analysis happen entirely in this tab.
    </p>
    <GtmAuditor client:visible />
  </main>
</Base>
