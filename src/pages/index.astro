---
import Base from "../layouts/Base.astro";
import { meta, summary, experience, skills, toolsIntro, contact } from "../data/resume.js";
import { tools } from "../data/tools.js";

const liveTools = tools.filter((t) => t.live);
---
<Base title={meta.title} description={meta.description}>
  <nav class="topnav" aria-label="Section">
    <div class="topnav-inner">
      <a href="#summary" class="brand">{contact.name}</a>
      <div class="links">
        <a href="#summary">Summary</a>
        <a href="#experience">Experience</a>
        <a href="#skills">Skills</a>
        <a href="#tools">Tools</a>
        <a href="#contact">Contact</a>
        <a href="/faysal-ahmed-resume.pdf" class="pdf-link">Download PDF</a>
      </div>
    </div>
  </nav>

  <main id="main-content" tabindex="-1">
    <section id="summary" class="section">
      <div class="summary-header">
        <div>
          <h1>{summary.headline}</h1>
          <p class="subhead">{summary.subhead}</p>
        </div>
        {summary.headshot?.enabled && (
          <img class="headshot" src={summary.headshot.src} alt={summary.headshot.alt} width="128" height="128" />
        )}
      </div>
      {summary.body.map((p) => <p>{p}</p>)}
      <ul class="stat-strip">
        {summary.stats.map((s) => <li>{s}</li>)}
      </ul>
    </section>

    <section id="experience" class="section">
      <h2>Experience</h2>
      {experience.map((role) => (
        <article class="role">
          <div class="role-header">
            <div>
              <h3>{role.company}</h3>
              {role.role && <p class="role-title">{role.role}</p>}
            </div>
            <div class="role-meta">
              <p class="dates">{role.dates}</p>
              {role.location && <p class="location">{role.location}</p>}
            </div>
          </div>

          {role.intro && <p class="role-intro">{role.intro}</p>}
          {role.prose && <p class="role-intro">{role.prose}</p>}

          {role.bulletGroups && role.bulletGroups.map((group) => (
            <div class="bullet-group">
              {group.label && <h4>{group.label}</h4>}
              <ul>
                {group.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          ))}

          {role.closing && <p class="role-closing">{role.closing}</p>}
        </article>
      ))}
    </section>

    <section id="skills" class="section">
      <h2>Skills</h2>
      <div class="skills-grid">
        {skills.map((s) => (
          <div class="skill-card">
            <h3>{s.category}</h3>
            <p>{s.items}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="tools" class="section">
      <h2>Tools</h2>
      <p>{toolsIntro}</p>
      <div class="tools-grid">
        {liveTools.map((tool) => (
          <a class="tool-card" href={`/tools/${tool.slug}/`}>
            <h3>{tool.name}</h3>
            <p>{tool.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="contact" class="section">
      <h2>Contact</h2>
      <p class="contact-name">{contact.name}</p>
      <p>{contact.location}</p>
      <p>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        {" · "}
        <a href={contact.linkedinUrl}>{contact.linkedin}</a>
        {" · "}
        <a href={`tel:${contact.phone.replace(/[^\d+]/g, "")}`}>{contact.phone}</a>
      </p>
    </section>
  </main>

  <style>
    :root {
      --max-width: 760px;
      --ink: #1a1a1a;
      --muted: #5a5a5a;
      --line: #e2e2e2;
      --accent: #3a5a9b;
    }

    main {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 2rem 1.5rem 5rem;
      font-family: system-ui, -apple-system, sans-serif;
      color: var(--ink);
      line-height: 1.55;
    }

    .topnav {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(6px);
      border-bottom: 1px solid var(--line);
    }
    .topnav-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0.85rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
      font-family: system-ui, sans-serif;
      font-size: 0.85rem;
    }
    .topnav a { color: var(--ink); text-decoration: none; }
    .topnav .brand { font-weight: 700; }
    .topnav .links { display: flex; gap: 1.1rem; align-items: center; flex-wrap: wrap; }
    .topnav .links a:hover { color: var(--accent); }
    .pdf-link {
      border: 1px solid var(--accent);
      color: var(--accent) !important;
      border-radius: 999px;
      padding: 0.3rem 0.8rem;
    }

    .section { padding: 2.5rem 0; border-bottom: 1px solid var(--line); }
    .section:last-child { border-bottom: none; }

    h1 { font-size: 2rem; margin-bottom: 0.25rem; }
    h2 { font-size: 1.4rem; margin-bottom: 1.25rem; }
    h3 { font-size: 1.1rem; margin: 0; }
    h4 { font-size: 0.95rem; margin: 0 0 0.4rem; }
    /* Skill/tool card titles are visually a step down from role titles (h3) but sit
       directly under an h2 with nothing between — using h3 here (not h4) keeps the
       heading hierarchy sequential (no skipped level) per WCAG 1.3.1 / axe heading-order. */
    .skill-card h3,
    .tool-card h3 { font-size: 0.95rem; margin: 0 0 0.4rem; }

    .summary-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1.5rem;
    }
    .headshot {
      width: 128px;
      height: 128px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
      border: 1px solid var(--line);
    }
    @media (max-width: 560px) {
      .summary-header { flex-direction: column-reverse; }
      .headshot { width: 96px; height: 96px; }
    }

    .subhead { color: var(--muted); font-size: 1.05rem; margin-bottom: 1.25rem; }

    .stat-strip {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      padding: 0;
      margin-top: 1.5rem;
    }
    .stat-strip li {
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 0.35rem 0.9rem;
      font-size: 0.8rem;
      color: var(--muted);
    }

    .role { margin-bottom: 2.5rem; }
    .role:last-child { margin-bottom: 0; }
    .role-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 0.5rem;
    }
    .role-title { margin: 0.1rem 0 0; color: var(--muted); }
    .role-meta { text-align: right; min-width: 0; }
    .dates { margin: 0; font-size: 0.85rem; color: var(--muted); }
    .location { margin: 0; font-size: 0.8rem; color: var(--muted); }
    .role-intro { color: var(--ink); }
    .role-closing { font-size: 0.9rem; color: var(--muted); margin-top: 0.75rem; }
    .bullet-group { margin-top: 0.75rem; }
    .bullet-group ul { margin: 0.25rem 0 0; padding-left: 1.1rem; }
    .bullet-group li { margin-bottom: 0.35rem; }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }
    .skill-card p { margin: 0; font-size: 0.88rem; color: var(--muted); }

    .tools-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
      margin-top: 1rem;
    }
    .tool-card {
      display: block;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 1rem;
      text-decoration: none;
      color: var(--ink);
      transition: border-color 0.15s;
    }
    .tool-card:hover { border-color: var(--accent); }
    .tool-card p { margin: 0.4rem 0 0; font-size: 0.85rem; color: var(--muted); }

    .contact-name { font-weight: 600; margin-bottom: 0.25rem; }

    @media (max-width: 480px) {
      .topnav .links { gap: 0.7rem; font-size: 0.78rem; }
      h1 { font-size: 1.6rem; }
    }
  </style>
</Base>
