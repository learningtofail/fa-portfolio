---
import "../styles/resume.css";
import Base from "../layouts/Base.astro";
import { meta, summary, experience, skills, toolsIntro, contact } from "../data/resume.js";
import { tools } from "../data/tools.js";

const liveTools = tools.filter((t) => t.live);
---

<Base title={meta.title} description={meta.description}>
  <nav class="topnav" aria-label="Section">
    <div class="topnav__inner">
      <a href="#summary" class="topnav__brand">
        {contact.name}
      </a>
      <div class="topnav__links">
        <a href="#summary" class="topnav__link">
          Summary
        </a>
        <a href="#experience" class="topnav__link">
          Experience
        </a>
        <a href="#skills" class="topnav__link">
          Skills
        </a>
        <a href="#tools" class="topnav__link">
          Tools
        </a>
        <a href="#contact" class="topnav__link">
          Contact
        </a>
        <a href="/faysal-ahmed-resume.pdf" class="topnav__link topnav__link--cta">
          Download PDF
        </a>
      </div>
    </div>
  </nav>

  <main id="main-content" tabindex="-1" class="page page--resume">
    <section id="summary" class="resume__section">
      <div class="resume__header">
        <div>
          <h1 class="resume__title">{summary.headline}</h1>
          <p class="resume__subhead">{summary.subhead}</p>
        </div>
        {summary.headshot?.enabled && (
          <img
            class="resume__headshot"
            src={summary.headshot.src}
            alt={summary.headshot.alt}
            width="128"
            height="128"
          />
        )}
      </div>
      {summary.body.map((p) => (
        <p>{p}</p>
      ))}
      <ul class="stat-strip">
        {summary.stats.map((s) => (
          <li class="stat-strip__item">{s}</li>
        ))}
      </ul>
    </section>

    <section id="experience" class="resume__section">
      <h2 class="resume__heading">Experience</h2>
      {experience.map((role) => (
        <article class="role">
          <div class="role__header">
            <div>
              <h3 class="role__company">{role.company}</h3>
              {role.role && <p class="role__title">{role.role}</p>}
            </div>
            <div class="role__meta">
              <p class="role__dates">{role.dates}</p>
              {role.location && <p class="role__location">{role.location}</p>}
            </div>
          </div>

          {role.intro && <p class="role__intro">{role.intro}</p>}
          {role.prose && <p class="role__intro">{role.prose}</p>}

          {role.bulletGroups &&
            role.bulletGroups.map((group) => (
              <div class="bullet-group">
                {group.label && <h4 class="bullet-group__title">{group.label}</h4>}
                <ul class="bullet-group__list">
                  {group.bullets.map((b) => (
                    <li class="bullet-group__item">{b}</li>
                  ))}
                </ul>
              </div>
            ))}

          {role.closing && <p class="role__closing">{role.closing}</p>}
        </article>
      ))}
    </section>

    <section id="skills" class="resume__section">
      <h2 class="resume__heading">Skills</h2>
      <div class="card-grid">
        {skills.map((s) => (
          <div class="skill-card">
            <h3 class="skill-card__title">{s.category}</h3>
            <p class="skill-card__text">{s.items}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="tools" class="resume__section">
      <h2 class="resume__heading">Tools</h2>
      <p>{toolsIntro}</p>
      <div class="card-grid card-grid--spaced">
        {liveTools.map((tool) => (
          <a class="tool-card" href={`/tools/${tool.slug}/`}>
            <h3 class="tool-card__title">{tool.name}</h3>
            <p class="tool-card__text">{tool.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="contact" class="resume__section">
      <h2 class="resume__heading">Contact</h2>
      <p class="contact__name">{contact.name}</p>
      <p>{contact.location}</p>
      <p>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        {" · "}
        <a href={contact.linkedinUrl}>{contact.linkedin}</a>
        {" · "}
        <a href={`tel:${contact.phone.replace(/[^\d+]/g, "")}`}>{contact.phone}</a>
      </p>
    </section>
  </main>
</Base>
