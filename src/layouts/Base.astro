---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Faysal Ahmed — VP of SEO & Organic Growth" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- No-SEO / block-bots decision, Phase 8 — set from day one rather than bolted on later -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- OG/Twitter card: no-index doesn't mean no-preview — Phase 8's Cloudflare
         rule explicitly exempts link-preview bots, so this is what actually
         renders when the URL is shared in Slack/iMessage/LinkedIn. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />
    <style is:global>
      /* Skip link: visually hidden until focused, first tab stop on every page. */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 2000;
        background: #1a1a1a;
        color: #fff;
        padding: 0.6rem 1rem;
        border-radius: 0 0 6px 0;
        font:
          600 0.9rem system-ui,
          sans-serif;
        text-decoration: none;
      }
      .skip-link:focus {
        left: 0;
      }
      /* Consistent, visible focus ring on every interactive element sitewide —
         WCAG 2.1 AA 2.4.7 (Focus Visible). Browser defaults are fine functionally,
         this just makes them consistent with the site's accent color. */
      a:focus-visible,
      button:focus-visible,
      input:focus-visible,
      select:focus-visible,
      textarea:focus-visible,
      [tabindex]:focus-visible {
        outline: 2px solid #3a5a9b;
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <slot />
  </body>
</html>
