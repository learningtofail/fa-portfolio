---
import Base from "./Base.astro";
import type { Tool } from "../data/tools.js";

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
---

<Base title={`${tool.title} — Faysal Ahmed`} description={tool.metaDescription}>
  <main id="main-content" tabindex="-1" class={tool.wide ? "page page--wide" : "page"}>
    <p>
      <a href="/tools/">&larr; All tools</a>
    </p>
    <h1>{tool.title}</h1>
    <p class="page__intro">{tool.intro}</p>
    <slot />
  </main>
</Base>
